{
  "swagger": "2.0",
  "info": {
    "title": "Inventory API",
    "description": "API documentation for the inventory project",
    "version": "1.0.0"
  },
  "host": "cse341-w3-project2.onrender.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "paths": {
    "/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/auth/github": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "description": "Starts the GitHub OAuth login process.",
        "responses": {
          "302": {
            "description": "Redirects the user to GitHub for authentication."
          },
          "500": {
            "description": "Authentication process failed."
          }
        }
      }
    },
    "/auth/github/callback": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "description": "Receives the user after GitHub authentication and creates the authenticated session.",
        "responses": {
          "302": {
            "description": "Redirects the authenticated user to the authentication status route."
          },
          "401": {
            "description": "GitHub authentication failed."
          },
          "500": {
            "description": "Authentication callback failed."
          }
        }
      }
    },
    "/auth/status": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "description": "Shows whether the current user is authenticated.",
        "responses": {
          "200": {
            "description": "Authentication status retrieved successfully."
          },
          "500": {
            "description": "Failed to check authentication status."
          }
        }
      }
    },
    "/auth/logout": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "description": "Logs out the current user and destroys the authenticated session.",
        "responses": {
          "200": {
            "description": "User logged out successfully."
          },
          "500": {
            "description": "Failed to log out the user."
          }
        }
      }
    },
    "/products/": {
      "get": {
        "tags": [
          "Products"
        ],
        "description": "Returns all products stored in the inventory.",
        "responses": {
          "200": {
            "description": "Products retrieved successfully."
          },
          "500": {
            "description": "Failed to retrieve products."
          }
        }
      },
      "post": {
        "tags": [
          "Products"
        ],
        "description": "Creates a new product in the inventory. Authentication is required.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Product information",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Cafeteira elétrica"
                },
                "description": {
                  "type": "string",
                  "example": "Cafeteira elétrica com capacidade para 30 xícaras"
                },
                "price": {
                  "type": "number",
                  "example": 149.9
                },
                "quantity": {
                  "type": "number",
                  "example": 8
                },
                "brand": {
                  "type": "string",
                  "example": "Mondial"
                },
                "sku": {
                  "type": "string",
                  "example": "MON-CAF-001"
                },
                "category": {
                  "type": "string",
                  "example": "Eletrodomésticos"
                },
                "supplier": {
                  "type": "string",
                  "example": "Distribuidora Paraná"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Product created successfully."
          },
          "400": {
            "description": "Invalid product data."
          },
          "401": {
            "description": "Authentication required."
          },
          "500": {
            "description": "Failed to create product."
          }
        }
      }
    },
    "/products/{id}": {
      "put": {
        "tags": [
          "Products"
        ],
        "description": "Updates an existing product using its MongoDB document id. Authentication is required.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB id of the product"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Updated product information",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Mouse sem fio"
                },
                "description": {
                  "type": "string",
                  "example": "Mouse ergonômico sem fio com conexão USB"
                },
                "price": {
                  "type": "number",
                  "example": 79.9
                },
                "quantity": {
                  "type": "number",
                  "example": 15
                },
                "brand": {
                  "type": "string",
                  "example": "Logitech"
                },
                "sku": {
                  "type": "string",
                  "example": "LOG-MOUSE-001"
                },
                "category": {
                  "type": "string",
                  "example": "Eletrônicos"
                },
                "supplier": {
                  "type": "string",
                  "example": "Distribuidora Tech Brasil"
                }
              }
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Product updated successfully."
          },
          "400": {
            "description": "Invalid product id or product data."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Product not found."
          },
          "500": {
            "description": "Failed to update product."
          }
        }
      },
      "delete": {
        "tags": [
          "Products"
        ],
        "description": "Deletes an existing product using its MongoDB document id. Authentication is required.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB id of the product"
          }
        ],
        "responses": {
          "204": {
            "description": "Product deleted successfully."
          },
          "400": {
            "description": "Invalid product id."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Product not found."
          },
          "500": {
            "description": "Failed to delete product."
          }
        }
      }
    },
    "/categories/": {
      "get": {
        "tags": [
          "Categories"
        ],
        "description": "Returns all categories stored in the inventory.",
        "responses": {
          "200": {
            "description": "Categories retrieved successfully."
          },
          "500": {
            "description": "Failed to retrieve categories."
          }
        }
      },
      "post": {
        "tags": [
          "Categories"
        ],
        "description": "Creates a new category in the inventory. Authentication is required.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Category information",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Eletrônicos"
                },
                "description": {
                  "type": "string",
                  "example": "Produtos eletrônicos e acessórios"
                },
                "department": {
                  "type": "string",
                  "example": "Tecnologia"
                },
                "active": {
                  "type": "boolean",
                  "example": true
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Category created successfully."
          },
          "400": {
            "description": "Invalid category data."
          },
          "401": {
            "description": "Authentication required."
          },
          "500": {
            "description": "Failed to create category."
          }
        }
      }
    },
    "/categories/{id}": {
      "put": {
        "tags": [
          "Categories"
        ],
        "description": "Updates an existing category using its MongoDB document id. Authentication is required.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB id of the category"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Updated category information",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Eletrônicos"
                },
                "description": {
                  "type": "string",
                  "example": "Produtos eletrônicos, acessórios e periféricos"
                },
                "department": {
                  "type": "string",
                  "example": "Tecnologia"
                },
                "active": {
                  "type": "boolean",
                  "example": true
                }
              }
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Category updated successfully."
          },
          "400": {
            "description": "Invalid category id or category data."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Category not found."
          },
          "500": {
            "description": "Failed to update category."
          }
        }
      },
      "delete": {
        "tags": [
          "Categories"
        ],
        "description": "Deletes an existing category using its MongoDB document id. Authentication is required.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB id of the category"
          }
        ],
        "responses": {
          "204": {
            "description": "Category deleted successfully."
          },
          "400": {
            "description": "Invalid category id."
          },
          "401": {
            "description": "Authentication required."
          },
          "404": {
            "description": "Category not found."
          },
          "500": {
            "description": "Failed to delete category."
          }
        }
      }
    }
  }
}